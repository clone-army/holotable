# Holotable settings. Copy to .env and edit (install.sh does this for you).

# The game's own folder - fs_basepath/fs_game, e.g. /opt/openjk/MBII.
# Maps and NPC types are read from its pk3s; scenarios are saved in its
# holotable/ folder (where the server looks for them) and NPC types you
# build go into ext_data/NPCs/holotable.npc.
GAMEDATA=/opt/openjk/MBII

# Where to listen.
HT_HOST=0.0.0.0
HT_PORT=8090

# The first account, made the first time Holotable starts with no accounts.
# Change the password here before first start (or in the app afterwards) -
# more accounts are added on the Users page.
HT_ADMIN_USER=admin
HT_ADMIN_PASSWORD=change-me-please

# Signs login sessions. Leave empty to have one made and kept in the data
# folder.
HT_SECRET_KEY=

# Holotable's own files (accounts, cached map geometry). Relative to this
# folder unless absolute.
HT_DATA_DIR=data

# Where scenarios go - by default GAMEDATA/holotable.
HT_SCENARIO_DIR=

# More folders of loose .npc files to offer as NPC types (colon separated),
# e.g. a server instance's own ext_data/NPCs.
HT_EXTRA_NPC_DIRS=
